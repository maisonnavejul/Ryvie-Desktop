{
  "name": "ryvie-connect",
  "version": "0.0.35",
  "description": "Application desktop pour Ryvie avec détection de connexion locale/publique",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "npm run icons:win && npm run fetch:netbird && electron-builder --win --publish never",
    "build:mac": "npm run icons:mac && electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "npm run icons:all && npm run fetch:netbird && electron-builder -mwl",
    "fetch:netbird": "node scripts/fetch-netbird.js",
    "icons:win": "node scripts/generate-icon.js",
    "icons:mac": "node scripts/generate-icon-mac.js",
    "icons:all": "node scripts/generate-icon.js && node scripts/generate-icon-mac.js",
    "publish": "npm run icons:all && npm run fetch:netbird && electron-builder -mwl --publish always"
  },
  "keywords": [
    "ryvie",
    "electron",
    "desktop"
  ],
  "author": {
    "name": "Ryvie",
    "email": "contact@ryvie.fr"
  },
  "license": "RSAL",
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^40.8.5",
    "electron-builder": "^26.7.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "got": "^11.8.5"
  },
  "build": {
    "appId": "com.ryvie.desktop",
    "productName": "Ryvie Connect",
    "extraResources": [
      {
        "from": "resources/netbird",
        "to": "netbird",
        "filter": [
          "**/*",
          "!**/*.md"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "ryvieos",
      "repo": "Ryvie-Connect"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/win/icon.ico",
      "artifactName": "Ryvie-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "allowElevation": true,
      "installerLanguages": [
        "fr_FR"
      ],
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icons/mac/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Jules Maisonnave (GW9M6A3925)",
      "notarize": true,
      "artifactName": "Ryvie-Connect-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "Ryvie-Connect-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/png",
      "category": "Utility"
    }
  }
}
