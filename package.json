{
  "name": "ryvie-desktop",
  "version": "0.0.32",
  "description": "Application desktop pour Ryvie avec détection de connexion locale/publique",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "npm run icons:win && electron-builder --win --publish never",
    "build:mac": "npm run icons:mac && electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "npm run icons:all && electron-builder -mwl",
    "icons:win": "node scripts/generate-icon.js",
    "icons:mac": "node scripts/generate-icon-mac.js",
    "icons:all": "node scripts/generate-icon.js && node scripts/generate-icon-mac.js",
    "publish": "npm run icons:all && electron-builder -mwl --publish always"
  },
  "keywords": [
    "ryvie",
    "electron",
    "desktop"
  ],
  "author": {
    "name": "Ryvie",
    "email": "contact@ryvie.fr"
  },
  "license": "RSAL",
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^40.8.5",
    "electron-builder": "^26.7.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "got": "^11.8.5"
  },
  "build": {
    "appId": "com.ryvie.desktop",
    "productName": "Ryvie",
    "publish": {
      "provider": "github",
      "owner": "maisonnavejul",
      "repo": "Ryvie-Desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/win/icon.ico",
      "artifactName": "Ryvie-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "allowElevation": true,
      "installerLanguages": [
        "fr_FR"
      ],
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icons/mac/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Jules Maisonnave (GW9M6A3925)",
      "notarize": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/png",
      "category": "Utility"
    }
  }
}
