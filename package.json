{
  "name": "ryvie-desktop",
  "version": "0.0.18",
  "description": "Application desktop pour Ryvie avec détection de connexion locale/publique",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "npm run icons:win && electron-builder --win --publish never",
    "build:mac": "npm run icons:mac && electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "npm run icons:all && electron-builder -mwl",
    "icons:win": "node scripts/generate-icon.js",
    "icons:mac": "node scripts/generate-icon-mac.js",
    "icons:all": "node scripts/generate-icon.js && node scripts/generate-icon-mac.js",
    "publish": "npm run icons:all && electron-builder -mwl --publish always"
  },
  "keywords": [
    "ryvie",
    "electron",
    "desktop"
  ],
  "author": {
    "name": "Jules Maisonnave",
    "email": "jules.maisonnave@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.ryvie.desktop",
    "productName": "Ryvie",
    "publish": {
      "provider": "github",
      "owner": "maisonnavejul",
      "repo": "Ryvie-Desktop"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "allowElevation": true,
      "installerLanguages": ["fr_FR"],
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icons/mac/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icons/png",
      "category": "Utility"
    }
  }
}
