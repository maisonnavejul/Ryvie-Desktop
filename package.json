{
  "name": "ryvie-desktop",
  "version": "0.0.13",
  "description": "Application desktop pour Ryvie avec détection de connexion locale/publique",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "npm run icons:win && electron-builder --win",
    "icons:win": "node scripts/generate-icon.js",
    "publish": "npm run icons:win && electron-builder --win --publish always"
  },
  "keywords": [
    "ryvie",
    "electron",
    "desktop"
  ],
  "author": "Ryvie",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.ryvie.desktop",
    "productName": "Ryvie",
    "publish": {
      "provider": "github",
      "owner": "maisonnavejul",
      "repo": "Ryvie-Desktop"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "allowElevation": true,
      "installerLanguages": ["fr_FR"],
      "deleteAppDataOnUninstall": false
    }
  }
}
